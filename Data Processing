--Best Performing Time of Day : revenue by hr


SELECT
EXTRACT(HOUR FROM transaction_time) AS sales_hour,
SUM(transaction_qty * unit_price) AS revenue
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY sales_hour
ORDER BY revenue DESC;

--Number of Transactions by Hour

SELECT
EXTRACT(HOUR FROM transaction_time) AS sales_hour,
COUNT(*) AS total_transaction
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY sales_hour
ORDER BY total_transaction DESC;

--Revenue by Time Period


SELECT
CASE
WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 6 AND 11 THEN 'Morning'
WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 12 AND 16 THEN 'Afternoon'
WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 17 AND 21 THEN 'Evening'
ELSE 'Night'
END AS time_period,
SUM(transaction_qty * unit_price) AS revenue
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY time_period
ORDER BY revenue DESC;

--Daily Sales Trend

SELECT
transaction_date,
SUM(transaction_qty * unit_price) AS daily_revenue
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY transaction_date
ORDER BY transaction_date;

--Monthly Sales Trend

SELECT
DATE_TRUNC('month', transaction_date) AS sales_month,
SUM(transaction_qty * unit_price) AS revenue
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY sales_month
ORDER BY sales_month;

--Product Sales Trend Over Time
SELECT
transaction_date,
product_detail,
SUM(transaction_qty * unit_price) AS revenue
FROM  brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY transaction_date, product_detail
ORDER BY transaction_date, revenue DESC;

--Store Performance Analysis

SELECT
store_location,
SUM(transaction_qty * unit_price) AS total_revenue,
COUNT(DISTINCT transaction_id) AS total_transactions
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY store_location
ORDER BY total_revenue DESC;

--Best-Selling Products by Quantity
SELECT
product_detail,
SUM(transaction_qty) AS units_sold
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY product_detail
ORDER BY units_sold DESC;

---CEO KPI Dashboard Query


SELECT
COUNT(DISTINCT transaction_id) AS total_transactions,
SUM(transaction_qty) AS total_units_sold,
SUM(transaction_qty * unit_price) AS total_revenue,
ROUND(
SUM(transaction_qty * unit_price)
/ COUNT(DISTINCT transaction_id), 2
) AS avg_order_value
FROM brighlearning.default.coffe_shop_excel_spreedsheet;


-- Big Data analysis



SELECT*
  FROM brighlearning.default.coffe_shop_excel_spreedsheet
  ;

  SELECT 
    transaction_date,
    DAYNAME(transaction_date) AS Day_name,  
    MONTHNAME(transaction_date) AS Month_name,
     COUNT(transaction_id) AS number_of_sales,  --- Counting all the rows. This will be a new column
     SUM(transaction_qty) AS units_sold, ---summing all the rows. This will be a new column
     COUNT(DISTINCT product_id) AS unique_products, ---Counting all the rows. This will be a new column
     COUNT(store_id) AS number_of_stores, ---Counting all the rows. This will be a new column
     SUM(transaction_qty * CAST(REPLACE(unit_price, ',', '.') AS DOUBLE)) AS total_revenue, ---summing all the rows. This will be a new column



    CASE 
        WHEN DAYNAME(transaction_date) IN ('Sat','Sun') THEN 'Weekend' ---DAYNAME gives the nam of a specific date. This will be a new column
        WHEN MONTHNAME(transaction_date) IN ('Mon','Tue','Wed','Thu','Fri') THEN 'Weekday' ---MONTHNAME gives the nam of a specific date. This will be a new column
    END AS day_classification,

    CASE 
        WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 6 AND 11 THEN 'Morning'
        WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 12 AND 17 THEN 'Afternoon'
        WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 18 AND 20 THEN 'Evening'
    END AS time_classification,  

    store_location,
    product_category,
    product_type,
    product_detail

FROM brighlearning.default.coffe_shop_excel_spreedsheet

GROUP BY 
    transaction_date,
    month_name,
    store_location,
    product_category,
    product_type,
    product_detail,

    CASE 
        WHEN DAYNAME(transaction_date) IN ('Sat','Sun') THEN 'Weekend'
        WHEN DAYNAME(transaction_date) IN ('Mon','Tues','Wed','Thu','Friday') THEN 'Weekday'
    END,

    CASE 
        WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 6 AND 11 THEN 'Morning'
        WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 12 AND 17 THEN 'Afternoon'
        WHEN EXTRACT(HOUR FROM transaction_time) BETWEEN 18 AND 20 THEN 'Evening'
    END;








