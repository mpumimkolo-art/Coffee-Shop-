--Small discriptive data that I want output from 


 --Daily Trend
SELECT DAYNAME(transaction_date) AS order_day,
 COUNT(DISTINCT transaction_id) AS total_orders 
FROM brighlearning.default.coffe_shop_excel_spreedsheet GROUP BY DAYNAME(transaction_date);

--Hourly Trend
SELECT HOUR(transaction_time) AS order_hours, COUNT(DISTINCT transaction_id) 
AS total_orders FROM brighlearning.default.coffe_shop_excel_spreedsheet GROUP BY order_hours ORDER BY order_hours;

-- Percentage of Drink Sales by Category
SELECT product_category, sum(transaction_qty * unit_price) as Total_Sales, SUM(transaction_qty * unit_price)*100/(SELECT sum(transaction_qty * unit_price) from brighlearning.default.coffe_shop_excel_spreedsheet) AS Percent_of_Total_Sales
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY product_category;

-- Percent of Drink Sales by Size
SELECT product_type, sum(transaction_qty * unit_price) as Total_Sales, SUM(transaction_qty * unit_price)*100/(SELECT sum(transaction_qty * unit_price) from brighlearning.default.coffe_shop_excel_spreedsheet) AS Percent_of_Total_Sales
FROM brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY product_type
ORDER BY Percent_of_Total_Sales DESC;

-- Total Drinks sold by Category
SELECT product_category, sum(transaction_qty) as Total_Drinks_Sold from brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY product_category;

--  Best Sellers by total drinks sold
SELECT product_detail, sum(transaction_qty) as Total_Drinks_Sold from brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY product_detail ORDER BY SUM(transaction_qty) DESC LIMIT 5;

--  Worst Sellers by total drinks sold
SELECT product_detail, sum(transaction_qty) as Total_Drinks_Sold from brighlearning.default.coffe_shop_excel_spreedsheet
GROUP BY product_detail ORDER BY SUM(transaction_qty) LIMIT 5;


